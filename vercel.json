{
  "installCommand": "npm install --prefix app/server && npm install --prefix app/web",
  "buildCommand": "npm run build --prefix app/web",
  "outputDirectory": "app/web/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "app/server/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api|metrics|assets|.*\\..*).*)", "destination": "/index.html" }
  ]
}
